
@page "/inscripciones/clases"
@using AppForSEII.Web.API
@inject AppForSEIIAPIClient API
@inject AppForSEII.Web.InscripcionClaseDeportivaStateContainer Estado
@inject NavigationManager Navegacion

<PageTitle>Inscribirse a clases deportivas</PageTitle>

<div class="container mt-4">

    <h3>Inscribirse a clases deportivas</h3>
    <p>Selecciona las clases deportivas en las que deseas inscribirte.</p>

    <div class="mb-3">

        <label class="form-label">Tipo de deporte</label>
        <input id="tipoDeporte" class="form-control"
               placeholder="Ej. Tenis"
               @bind="tipoDeporte" />

        <label class="form-label mt-2">Monitor</label>
        <input id="monitor" class="form-control"
               placeholder="Ej. Laura"
               @bind="monitor" />

        <label class="form-label mt-2">Fecha</label>
        <input id="fecha" type="date"
               class="form-control"
               @bind="fecha" />

        <button id="buscarClases"
                class="btn btn-primary mt-3"
                @onclick="BuscarClases">
            Buscar clases
        </button>
    </div>

    @if (mensajeError != null)
    {
        <div class="alert alert-warning" id="mensajeError">
            @mensajeError
        </div>
    }
    else if (clases.Count == 0)
    {
        <div class="alert alert-info">
            No hay clases deportivas disponibles.
        </div>
    }
    else
    {
        <p>Clases encontradas: @clases.Count</p>

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="tablaClases">
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th>Deporte</th>
                        <th>Monitor</th>
                        <th>Nivel</th>
                        <th>Fecha y hora</th>
                        <th>Lugar</th>
                        <th>Plazas</th>
                        <th>Precio</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clase in clases)
                    {
                        <tr>
                            <td>@clase.Descripcion</td>
                            <td>@clase.TipoDeporte</td>
                            <td>@clase.Monitor</td>
                            <td>@clase.Nivel</td>
                            <td>@clase.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(clase.Lugar ?? "No especificado")</td>
                            <td>@clase.PlazasDisponibles</td>
                            <td>@clase.PrecioUnitario.ToString("F2") €</td>
                            <td>
                                <button id="anadirClase_@clase.Id"
                                        class="btn btn-outline-primary btn-sm"
                                        disabled="@Estado.ClasesSeleccionadas.ContainsKey(clase.Id)"
                                        @onclick="() => Estado.AgregarClase(clase)">
                                    @(Estado.ClasesSeleccionadas.ContainsKey(clase.Id)
                                        ? "Añadida"
                                        : "Añadir")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card mt-4">
        <div class="card-body">

            <h5 class="card-title">Carrito de inscripciones</h5>

            @if (Estado.Inscripcion.ClasesInscritas.Count == 0)
            {
                <p class="text-muted">
                    Todavía no has seleccionado ninguna clase deportiva.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table" id="tablaCarrito">
                        <thead>
                            <tr>
                                <th>Clase</th>
                                <th>Precio unitario</th>
                                <th>Plazas</th>
                                <th>Subtotal</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Estado.Inscripcion.ClasesInscritas.ToList())
                            {
                                var claseOriginal =
                                    Estado.ClasesSeleccionadas[item.ClaseDeportivaId];

                                <tr>
                                    <td>@item.Descripcion</td>

                                    <td>
                                        @claseOriginal.PrecioUnitario.ToString("F2") €
                                    </td>

                                    <td>
                                        <select id="plazas_@item.ClaseDeportivaId"
                                                class="form-select form-select-sm"
                                                value="@item.PlazasReservadas"
                                                @onchange="e => CambiarPlazas(item.ClaseDeportivaId, e)">
                                            @for (int n = 1; n <= Math.Min(3, claseOriginal.PlazasDisponibles); n++)
                                            {
                                                <option value="@n">@n</option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        @item.Precio.ToString("F2") €
                                    </td>

                                    <td>
                                        <button id="eliminarClase_@item.ClaseDeportivaId"
                                                class="btn btn-outline-danger btn-sm"
                                                @onclick="() => Estado.EliminarClase(item.ClaseDeportivaId)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p>
                    Clases seleccionadas:
                    <strong>@Estado.Inscripcion.ClasesInscritas.Count</strong>
                </p>

                <p>
                    <strong>
                        Precio total: @Estado.PrecioTotal.ToString("F2") €
                    </strong>
                </p>

                <button id="vaciarCarrito"
                        class="btn btn-outline-danger"
                        @onclick="Estado.VaciarCarrito">
                    Vaciar carrito
                </button>
            }

            <div class="mt-3">
                <button id="inscribirse"
                        class="btn btn-primary"
                        disabled="@(Estado.Inscripcion.ClasesInscritas.Count == 0)"
                        @onclick="IrACrearInscripcion">
                    Inscribirse
                </button>
            </div>

        </div>
    </div>

</div>

@code {
    private ICollection<ClaseDeportivaForInscripcionDTO> clases =
        new List<ClaseDeportivaForInscripcionDTO>();

    private string? tipoDeporte;
    private string? monitor;
    private DateTime? fecha;

    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await BuscarClases();
    }

    private async Task BuscarClases()
    {
        mensajeError = null;

        DateTimeOffset? fechaFiltro = fecha.HasValue
            ? new DateTimeOffset(fecha.Value.Date)
            : null;

        try
        {
            clases = await API.GetClasesDeportivasForInscripcionAsync(
                string.IsNullOrWhiteSpace(tipoDeporte)
                    ? null : tipoDeporte.Trim(),
                string.IsNullOrWhiteSpace(monitor)
                    ? null : monitor.Trim(),
                fechaFiltro);
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            clases = new List<ClaseDeportivaForInscripcionDTO>();
            mensajeError = "No hay clases deportivas con esos criterios.";
        }
        catch (Exception)
        {
            clases = new List<ClaseDeportivaForInscripcionDTO>();
            mensajeError = "No se han podido cargar las clases deportivas.";
        }
    }

    private void CambiarPlazas(int claseDeportivaId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int plazas) &&
            Estado.ClasesSeleccionadas.TryGetValue(
                claseDeportivaId, out var clase))
        {
            Estado.ActualizarPlazas(clase, plazas);
        }
    }

    private void IrACrearInscripcion()
    {
        if (Estado.Inscripcion.ClasesInscritas.Count > 0)
        {
            Navegacion.NavigateTo("/inscripciones/clases/crear");
        }
    }
}
