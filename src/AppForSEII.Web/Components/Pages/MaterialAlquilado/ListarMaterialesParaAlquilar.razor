@* 1. Directives *@
@page "/materialalquilado/listarmaterialesparaalquilar"
@using AppForSEII.Web.API
@inject AppForSEIIAPIClient apiservice
@* @attribute [Authorize] *@
@* 2. Markup with C# expressions *@
<button @onclick="@SearchMateriales">Search</button>
@* 3. C# logic *@
@code {
private ICollection<MaterialDTO>? Material { get; set; } = new
List<MaterialDTO>();
protected async void SearchMateriales() {
    try{ Material = await apiservice.GetMaterialesAsync(
    null, null,null, null);
    } catch (ApiException ex) {
        Material = new List<MaterialDTO>();
    }
    StateHasChanged();
}
}
