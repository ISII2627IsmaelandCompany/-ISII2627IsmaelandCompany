
@* Ruta para acceder a la pantalla de selección de pistas *@
@page "/reservas/pistas"

@*importamos el cliente y los DTOs de la Api*@
@using AppForSEII.Web.API

@* Para permitir el acceso únicamente a usuarios autenticados (autorize) *@
@using Microsoft.AspNetCore.Authorization

@* Inyectamos el cliente de la API para consultar las pistas *@
@inject AppForSEIIAPIClient API

@* Inyectamos el logger para registrar posibles errores *@
@inject ILogger<ListarPistasParaReservar> logger

@* Solo permitimos el acceso a usuarios autenticados *@
@attribute [Authorize]

@* el StateContainer para gestionar el carrito de pistas seleccionadas *@
@inject AppForSEII.Web.PistaReservadaStateContainer Estado

@*para poder navegar del select al create*@
@inject NavigationManager Navegacion

@*titulo de la pestaña*@
<PageTitle>Reservar pistas deportivas</PageTitle>

@* Contenedor principal de la interfaz *@
<div class="container mt-4">

    @* mostrar título y descripción de la pantalla *@
    <h3>Reservar pistas</h3>
    <p>Selecciona las pistas que deseas reservar.</p>

    @* Filtros para buscar pistas disponibles segun lo que quiera el cliente *@
    <div class="mb-3">

        @* Filtro por tipo de deporte. vinculamos el campo con la variable tipoDeporte con @bind *@
        <label class="form-label">Tipo de deporte</label>
        <input id="tipoDeporte"
               class="form-control"
               placeholder="Ej. Tenis"
               @bind="tipoDeporte" />

        @* Filtro por fecha inicial *@
        <label class="form-label mt-2">Fecha desde</label>
        <input id="fechaDesde"
               type="date"
               class="form-control"
               @bind="fechaDesde" />

        @* Filtro por fecha final *@
        <label class="form-label mt-2">Fecha hasta</label>
        <input id="fechaHasta"
               type="date"
               class="form-control"
               @bind="fechaHasta" />

        @* Al pulsar el botón buscamos las pistas *@
        <button id="buscarPistas"
                class="btn btn-primary mt-3"
                @onclick="BuscarPistas">
            Buscar pistas
        </button>

    </div>

    @* Si existe un mensaje de error lo mostramos *@
    @if (mensajeError != null)
    {
        <div class="alert alert-warning" id="mensajeError">
            @mensajeError
        </div>
    }

    @* Si no hay pistas disponibles mostramos un mensaje *@
    else if (pistas.Count == 0)
    {
        <div class="alert alert-info">
            No hay pistas disponibles.
        </div>
    }

    @* Si existen pistas disponibles mostramos los resultados *@
    else
    {
        <p>Pistas encontradas: @pistas.Count</p>

        @* Tabla con las pistas disponibles *@
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="tablaPistas">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Deporte</th>
                        <th>Aforo máximo</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>
                    @* Recorremos las pistas obtenidas de la API. recorremos la lista de pistas y mostramos los datos de cada una *@
                    @foreach (var pista in pistas)
                    {
                        <tr>
                            <td>@pista.NombrePista</td>
                            <td>@pista.TipoDeporte</td>
                            <td>@pista.NPersonas</td>
                            <td>@pista.Precio.ToString("F2") €</td>
                            <td>@pista.Stock</td>

                            <td>
                                @* Añadimos la pista al carrito mediante el StateContainer, si ya esta seleccionada deshabilitamos boton para duplicados *@
                                <button id="anadirPista_@pista.IdPista"
                                        class="btn btn-outline-primary btn-sm"
                                        disabled="@Estado.PistasSeleccionadas.ContainsKey(pista.IdPista)"
                                        @onclick="() => Estado.AgregarPista(pista)">
                                    @(Estado.PistasSeleccionadas.ContainsKey(pista.IdPista)
                                        ? "Añadida"
                                        : "Añadir")

                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    @* Carrito de las pistas seleccionadas y permite gestionarlas*@
    <div class="card mt-4">
        <div class="card-body">

            <h5 class="card-title">Carrito de reservas</h5>

            @* Si el carrito está vacío mostramos un mensaje *@
            @if (Estado.Reserva.PistasReservadas.Count == 0)
            {
                <p class="text-muted">
                    Todavía no has seleccionado ninguna pista.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table" id="tablaCarrito">

                        <thead>
                            <tr>
                                <th>Pista</th>
                                <th>Deporte</th>
                                <th>Precio</th>
                                <th>Personas</th>
                                <th>Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @* Recorremos las pistas almacenadas en el StateContainer *@
                            @foreach (var item in Estado.Reserva.PistasReservadas.ToList())
                            {
                                @* Recuperamos los datos originales de la pista *@
                                var pistaOriginal = Estado.PistasSeleccionadas[item.IdPista];

                                <tr>
                                    <td>@item.NombrePista</td>

                                    <td>@item.TipoDeporte</td>

                                    <td>
                                        @item.Precio.ToString("F2") €
                                    </td>

                                    <td>
                                        @* Desplegable que es para modificar el número de las personas. si se cambia el valor se llama a CambiarCantidad *@
                                        <select id="cantidad_@item.IdPista"
                                                class="form-select form-select-sm"
                                                value="@item.Cantidad"
                                                @onchange="e => CambiarCantidad(item.IdPista, e)">

                                            @* El número de personas no puede superar el aforo *@
                                            @for (int n = 1; n <= pistaOriginal.NPersonas; n++)
                                            {
                                                <option value="@n">@n</option>
                                            }

                                        </select>
                                    </td>

                                    <td>
                                        @* Eliminamos la pista del carrito utilizando su ID *@
                                        <button id="eliminarPista_@item.IdPista"
                                                class="btn btn-outline-danger btn-sm"
                                                @onclick="() => Estado.EliminarPista(item.IdPista)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                @* para mostrar el numero de pistas seleccionadas *@
                <p>
                    Pistas seleccionadas:
                    <strong>@Estado.Reserva.PistasReservadas.Count</strong>
                </p>

                @* el precio total calculado por el StateContainer *@
                <p>
                    <strong>
                        Precio total: @Estado.PrecioTotal.ToString("F2") €
                    </strong>
                </p>

                @* Eliminamos todas las pistas que hay seleccionadas del carrito *@
                <button id="vaciarCarrito"
                        class="btn btn-outline-danger"
                        @onclick="Estado.VaciarCarrito">
                    Vaciar carrito
                </button>
            }
            @* Continuar con el formulario de la creación de reserva, si el carrito está vacío deshabilitamos  botón. *@
            <div class="mt-3">
                <button id="reservarPistas"
                        class="btn btn-primary"
                        disabled="@(Estado.Reserva.PistasReservadas.Count == 0)"
                        @onclick="IrACrearReserva">
                    Reservar
                </button>
            </div>

        </div>
    </div>

</div>

@code {

    // Lista donde almacenamos las pistas q obtenemos dde la api
    private ICollection<PistaDTO> pistas = new List<PistaDTO>();

    // almacenar el deporte que ha introducido el usuario
    private string? tipoDeporte;

    //almacenar las fechas seleccionadas
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;

    // variable para que se muestren los mensajes de error
    private string? mensajeError;

    // Método que se ejecuta al iniciar(la patalla)
    protected override async Task OnInitializedAsync()
    {
        // Establecemos como fecha inicial mañana
        fechaDesde = DateTime.Today.AddDays(1);
        // como fecha final pasado mañana
        fechaHasta = DateTime.Today.AddDays(2);

        // Cargar las pistas para esas fechas al entrar
        await BuscarPistas();
    }

    // Método ASINCRONO para consultar pistas que estan disponibles según los filtros
    private async Task BuscarPistas()
    {
        // Eliminamos mensaje de error de la búsqueda anterior
        mensajeError = null;

        // Comprobamos que la fecha inicial no sea posterior a la final
        if (fechaDesde.HasValue && fechaHasta.HasValue &&
            fechaDesde.Value.Date > fechaHasta.Value.Date)
        {
            mensajeError = "La fecha inicial no puede ser posterior a la fecha final.";
            pistas = new List<PistaDTO>();
            return;
        }

        // Convertimos las fechas al tipo DateTimeOffset para la API
        DateTimeOffset? desde = fechaDesde.HasValue
            ? new DateTimeOffset(fechaDesde.Value.Date)
            : null;

        DateTimeOffset? hasta = fechaHasta.HasValue
            ? new DateTimeOffset(fechaHasta.Value.Date)
            : null;

        try
        {
            // Llamamos al select(metodo GetPistasAsync) de la API pasando los filtros
            // Si filtro de deporte vacío == null
            //Trim compacta espacios o huecos sobrantes en texto
            pistas = await API.GetPistasAsync(
                string.IsNullOrWhiteSpace(tipoDeporte)
                    ? null! : tipoDeporte.Trim(),
                desde,
                hasta);
        }
        catch (ApiException ex) when (ex.StatusCode == 400)
        {
            // Si la api devuelve 400 es porque no hay resultados y entonces vaciamos la lista
            pistas = new List<PistaDTO>();
            mensajeError = "No hay pistas disponibles con esos criterios.";
        }
        catch (Exception ex)
        {
            // Registramos el error producido al consultar la api
            logger.LogError(ex, "Error al cargar las pistas.");

            pistas = new List<PistaDTO>();
            mensajeError = "No se han podido cargar las pistas.";
        }
    }

    // Método que modifica la cantidad de personas de una pista
    private void CambiarCantidad(int idPista, ChangeEventArgs e)
    {//convertimos el valor seleccionado en el desplegable a entero y buscamos la pista original por su id
        if (int.TryParse(e.Value?.ToString(), out int cantidad) &&
            Estado.PistasSeleccionadas.TryGetValue(idPista, out var pista))
        {
            // Actualizar la cantidad mediante StateContainer
            Estado.ActualizarCantidad(pista, cantidad);
        }
    }

        // Método para navegar a la pantalla de creación de reserva
        private void IrACrearReserva()
        {// hay al menos una pista seleccionada
            if (Estado.Reserva.PistasReservadas.Count > 0)
            {
                // Navegamos conservando el carrito
                Navegacion.NavigateTo("/reservas/pistas/crear");
            }
        }

}
